# ─── Supabase (opcional em desenvolvimento: sem ele o app roda em "modo visitante") ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Somente no servidor. NUNCA exponha no navegador nem use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Mentor (IA) ───
ANTHROPIC_API_KEY=
# Modelo do mentor. Padrão: claude-opus-5-5. Para reduzir custo: claude-sonnet-5-5 ou claude-haiku-5-5.
MENTOR_MODEL=
# Conversas por dia, por plano.
MENTOR_DAILY_LIMIT_FREE=10
MENTOR_DAILY_LIMIT_PREMIUM=100
# Apenas para desenvolvimento local SEM Supabase: libera o mentor sem login.
ALLOW_GUEST_MENTOR=false
